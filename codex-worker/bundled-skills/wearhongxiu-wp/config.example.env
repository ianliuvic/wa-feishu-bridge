# Dedicated Wearhongxiu WordPress credentials.
WEARHONGXIU_WP_URL=https://wearhongxiu.com
WEARHONGXIU_WP_USER=
WEARHONGXIU_WP_APP_PASSWORD=
WEARHONGXIU_WP_TIMEOUT=30

# Optional Hostinger cache-purge configuration.
WEARHONGXIU_HOSTINGER_API_TOKEN=
WEARHONGXIU_HOSTINGER_USERNAME=
WEARHONGXIU_HOSTINGER_DOMAIN=wearhongxiu.com
WEARHONGXIU_HOSTINGER_API_BASE=https://developers.hostinger.com

# Optional Google Search Console configuration. The service-account JSON must
# already have access to the Wearhongxiu Search Console property.
WEARHONGXIU_GSC_CREDENTIALS=
WEARHONGXIU_GSC_SITE_URL=https://wearhongxiu.com/
WEARHONGXIU_GSC_SITEMAP_URL=https://wearhongxiu.com/sitemap_index.xml

# Optional PageSpeed Insights API key. The SEO CLI can try the public endpoint
# without a key, but configured quota is more reliable for repeated audits.
WEARHONGXIU_PAGESPEED_API_KEY=

# Optional Industry News workflow. These credentials are used only by
# scripts/industry_news.py for discovery, source reading, drafting and
# source-image review. Crun credentials remain owned by the crun-imagen skill.
WEARHONGXIU_NEWSAPI_KEY=
WEARHONGXIU_JINA_API_TOKEN=
WEARHONGXIU_LLM_BASE_URL=
WEARHONGXIU_LLM_API_KEY=
WEARHONGXIU_LLM_MODEL=
WEARHONGXIU_VISION_LLM_BASE_URL=
WEARHONGXIU_VISION_LLM_API_KEY=
WEARHONGXIU_VISION_LLM_MODEL=

# Website RAG access used by scripts/rag_sync.py after publication.
HONGXIU_RAG_TOKEN=

# GA4 property 512505206. It may reuse the GSC service account when that
# account has GA4 Viewer access.
WEARHONGXIU_GA4_CREDENTIALS=
